<?xml version="1.0" encoding="utf-8"?>
<!--
    Library manifest.

    Intentionally empty: an <application> element declared here is merged into every
    consuming app, so attributes such as android:icon, android:roundIcon and
    android:allowBackup would silently override (or conflict with) the app's own.
    A view library has nothing to contribute to the merged manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
